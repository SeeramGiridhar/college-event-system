# Copy this file to .env (or set these directly in your Netlify dashboard).
# NEVER commit a .env file with real values.

# Your Supabase project URL (found in Dashboard > Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your Supabase anon/publishable key (safe to expose to browsers, RLS protects data)
SUPABASE_ANON_KEY=eyJhbGci...your_anon_key_here

# The public URL your app is deployed at (used for OAuth redirect & password reset)
# e.g. https://your-site.netlify.app  (no trailing slash)
APP_URL=https://your-site.netlify.app
